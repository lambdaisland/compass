{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure {:mvn/version "1.12.5"}

  ;; HTTP
  ring/ring-jetty-adapter {:mvn/version "1.15.5"}
  fi.metosin/reitit       {:mvn/version "0.7.0-alpha6"}
  ring/ring-defaults      {:mvn/version "0.7.1"}

  ;; System/config
  integrant/integrant     {:mvn/version "1.0.1"}
  integrant/repl          {:mvn/version "0.5.1"}
  com.lambdaisland/config {:mvn/version "0.15.56"}
  com.lambdaisland/cli    {:mvn/version "1.30.130"}

  ;; HTML/CSS
  com.lambdaisland/hiccup   {:mvn/version "0.14.67"}
  com.lambdaisland/ornament {:git/sha "488ba0bb078ecf4dfed779221eaee71f19a85a33"
                             :git/url "https://github.com/lambdaisland/ornament.git"}

  ;; Logging
  io.pedestal/pedestal.log       {:mvn/version "0.8.1"}
  ch.qos.logback/logback-classic {:mvn/version "1.6.3"}

  ;; DB
  com.datomic/peer            {:mvn/version "1.0.7705"
                               :exclusions  [joda-time/joda-time]}
  com.lambdaisland/wagontrain {:mvn/version "0.6.15"}

  ;; Formats & Utils
  com.cnuernber/charred                 {:mvn/version "1.041"}
  cheshire/cheshire                     {:mvn/version "6.2.0"}
  clj.qrgen/clj.qrgen                   {:mvn/version "0.4.0"}
  hato/hato                             {:mvn/version "1.0.0"}
  lambdaisland/uri                      {:mvn/version "1.19.155"}
  clojure.java-time/clojure.java-time   {:mvn/version "1.4.3"}
  java-time-literals/java-time-literals {:mvn/version "2018-04-06"}
  potemkin/potemkin                     {:mvn/version "0.4.9"} ; def-map-type
  mvxcvi/puget                          {:mvn/version "1.3.4"}

  ;; Crypto / JWT (parses PEM keys, PKCS#1 and PKCS#8, and signs JWS/JWT)
  buddy/buddy-core {:mvn/version "1.12.0-430"}
  buddy/buddy-sign {:mvn/version "3.6.1-359"}

  ;; Markdown
  markdown-to-hiccup/markdown-to-hiccup {:mvn/version "0.6.2"}
  com.drewnoakes/metadata-extractor     {:mvn/version "2.21.0"}
  }


 :aliases
 {:dev
  {:extra-paths ["dev"]
   :extra-deps  {org.clojure/tools.namespace {:mvn/version "1.5.1"}}}

  :prod
  {:extra-deps
   {org.postgresql/postgresql {:mvn/version "42.7.13"}}}

  :test
  {:extra-paths ["test"]
   :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}}}}}
