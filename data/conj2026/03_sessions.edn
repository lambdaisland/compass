   :session/title "Coffee Break",
   :session/time #time/zdt "2026-10-02T14:50-04:00[America/New_York]",
   :session/duration "PT40M",
   :session/location :location.type/_206ab,
   :session/type :session.type/break,
   :session/capacity 500,
