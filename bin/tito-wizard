#!/usr/bin/env bash
#
# A wizard — walks a human through a manual procedure step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library — delightful, consistent UX. Identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear — wipe the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" — opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later — it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" — clear the screen, then announce a stage and show progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." — a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." — a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL — open in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else warn "couldn't open a browser — visit it manually: $url"; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser — visit it manually: $url"
}

# pause "msg" — wait for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" — y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY — current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# ask KEY "Prompt" — read a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" — like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE — upsert KEY=VALUE into ENV_FILE (creates it; replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE — set a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name — gh not ready; set it later"
}

# set_var NAME VALUE — set a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name — gh not ready; set it later"
}

# finish — clear, then a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES — author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# ──────────────────────────────────────────────────────────────────────────

TOTAL_STAGES=8

# Values land in config.local.edn (EDN), not .env. These helpers mirror the
# library's ask/write pair but read and upsert EDN keys via babashka, so the
# file stays valid EDN whatever the value contains. Keep-current defaults come
# from config.local.edn; the placeholder "..." counts as unset.
CONFIG_FILE="config.local.edn"
ENV_FILE="$CONFIG_FILE"  # so finish() reports the right file

_BB_GET='(let [[f k] *command-line-args*
               v (get (clojure.edn/read-string (slurp f)) (clojure.edn/read-string k))]
           (when (string? v) (print v)))'
_BB_SET='(let [[f k v raw] *command-line-args*
               m (clojure.edn/read-string (slurp f))
               v (if (seq raw) (clojure.edn/read-string v) v)]
           (spit f (with-out-str (clojure.pprint/pprint (into (sorted-map) (assoc m (clojure.edn/read-string k) v))))))'
_BB_LIST_RELEASES='(do (require (quote [cheshire.core :as json]))
  (doseq [r (:releases (json/parse-string (slurp *in*) true))]
    (println (str "    " (:slug r) "  —  " (:title r)))))'
_BB_STREAM_IDS='(doseq [s (:mux/streams (clojure.edn/read-string (slurp (first *command-line-args*))))]
  (println (:id s)))'
_BB_SET_STREAM_SLUGS='(let [[f id slugs] *command-line-args*
      m (clojure.edn/read-string (slurp f))
      slugset (into #{} (remove clojure.string/blank?) (clojure.string/split slugs #"[, ]+"))
      streams (mapv (fn [s] (if (= id (:id s)) (assoc s :allowed-ticket-slugs slugset) s))
                    (:mux/streams m))]
  (spit f (with-out-str (clojure.pprint/pprint (into (sorted-map) (assoc m :mux/streams streams))))))'

require_bb() {
  command -v bb >/dev/null 2>&1 && return 0
  warn "babashka (bb) is required to edit $CONFIG_FILE — install it first: brew install borkdude/brew/babashka"
  exit 1
}

# edn_get :ns/key — current string value in CONFIG_FILE ("" if absent/placeholder)
edn_get() {
  [[ -f "$CONFIG_FILE" ]] || return 1
  local v
  v=$(bb -e "$_BB_GET" "$CONFIG_FILE" "$1") || return 1
  [[ "$v" == "..." ]] && v=""
  printf '%s' "$v"
}

# write_edn :ns/key VALUE [raw] — upsert into CONFIG_FILE. With the third arg
# set, VALUE is parsed as EDN (for maps/booleans); otherwise stored as a string.
write_edn() {
  local key="$1" value="$2" raw="${3:-}"
  [[ -f "$CONFIG_FILE" ]] || printf '{}\n' > "$CONFIG_FILE"
  bb -e "$_BB_SET" "$CONFIG_FILE" "$key" "$value" "$raw"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$CONFIG_FILE"
}

# ask_edn VAR "Prompt" :ns/key — like ask, but keep-current comes from EDN.
ask_edn() {
  local var="$1" prompt="$2" ekey="$3" current input
  current=$(edn_get "$ekey" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$var" '%s' "$input"
}

# ask_edn_secret VAR "Prompt" :ns/key — hidden-input variant of ask_edn.
ask_edn_secret() {
  local var="$1" prompt="$2" ekey="$3" current input
  current=$(edn_get "$ekey" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$var" '%s' "$input"
}

require_bb

banner "Compass — ti.to ticketing setup"

if [[ -f "$CONFIG_FILE" ]]; then
  cp "$CONFIG_FILE" "$CONFIG_FILE.wizard-bak"
  note "backed up $CONFIG_FILE → $CONFIG_FILE.wizard-bak"
fi

# ── Stage 1 ───────────────────────────────────────────────────────────────
stage "Ti.to account & event"
say "Compass reads ticket data from the ti.to API. It needs an account (team),"
say "an event under it, and the combined slug 'account-slug/event-slug'."
open_url "https://dashboard.tito.io/"
step "Sign up or sign in (ti.to accounts are free until you sell paid tickets)."
step "Create a team/account for your conference if you don't have one."
step "Create the event (or open the existing one)."
step "Look at the dashboard URL: https://dashboard.tito.io/<account>/<event>"
say "  — the part after dashboard.tito.io/ is the slug Compass needs."
note "The repo default is heart-of-clojure/2024 (resources/compass/config.edn);"
note "your $CONFIG_FILE value overrides it."
ask_edn TITO_EVENT_SLUG "Enter the event slug (account/event):" ":tito/event-slug"
if [[ "$TITO_EVENT_SLUG" != */* ]]; then
  warn "That doesn't look like account/event — double-check before continuing."
fi
write_edn ":tito/event-slug" "$TITO_EVENT_SLUG"

# ── Stage 2 ───────────────────────────────────────────────────────────────
stage "Ticket types (releases) and their slugs"
say "In ti.to each ticket type is a 'release' with a slug (derived from its"
say "title, editable). Compass keys everything off these slugs:"
say "  • Discord role mapping     — :discord/ticket-roles {slug → role-id}"
say "  • Livestream access        — :mux/streams :allowed-ticket-slugs #{slug…}"
open_url "https://dashboard.tito.io/$TITO_EVENT_SLUG"
step "Open 'Tickets' and create a ticket type per audience you distinguish,"
say "  e.g. early-bird, regular-conference, late-conference, student, crew,"
say "  sponsor, speaker, diversity-ticket, streaming."
note "Compass hard-codes a catch-all: tickets with slug crew, sponsor, speaker,"
note "diversity-ticket, early-bird, regular-conference, late-conference or"
note "student ALSO get the role mapped under \"regular-ticket\""
note "(src/lambdaisland/compass/services/discord.clj). Reuse these exact slugs"
note "to benefit from it, or adjust that list in code."
step "Check each ticket type's slug (edit the release → URL/slug field)."
warn "Buyers must ASSIGN tickets (name + email) in ti.to — Compass matches the"
warn "attendee by registration reference + the email on the assigned ticket."
pause "Press Enter when your ticket types exist."

# ── Stage 3 ───────────────────────────────────────────────────────────────
stage "API access token"
say "Compass authenticates with a personal API token (v3 'Secret Key')."
open_url "https://id.tito.io/api-access-tokens"
step "Click 'Create API Access Token' with exactly:"
say "    Test Mode: OFF"
say "    Type:      Secret Key"
say "    Version:   3.0"
step "Copy the generated token."
note "The token belongs to your user and grants access to all its accounts —"
note "treat it as a secret, it is only stored in $CONFIG_FILE (gitignored)."
ask_edn_secret TITO_API_KEY "Paste the API token:" ":tito/api-key"
write_edn ":tito/api-key" "$TITO_API_KEY"

# ── Stage 4 ───────────────────────────────────────────────────────────────
stage "Verify token & event slug against the live API"
say "Calling https://api.tito.io/v3/$TITO_EVENT_SLUG/releases …"
if _releases_json=$(curl -sf \
    -H "Authorization: Token token=$TITO_API_KEY" \
    -H "Accept: application/json" \
    "https://api.tito.io/v3/$TITO_EVENT_SLUG/releases"); then
  say "${GREEN}✓ API call succeeded.${RESET} Ticket type slugs found:"
  printf '%s' "$_releases_json" | bb -e "$_BB_LIST_RELEASES" \
    || note "  (could not pretty-print the response, but the call worked)"
  say "Use these slugs in the next stages."
else
  warn "API call failed."
  note "401/403 → token wrong, test-mode token, or wrong type (need Secret Key)."
  note "404     → event slug wrong, or your token's user lacks access to the account."
  if ! confirm "Continue anyway?"; then
    say "Re-run bin/tito-wizard after fixing the token/slug — saved values are remembered."
    exit 1
  fi
  SKIPPED+=("API verification failed — re-check :tito/api-key and :tito/event-slug")
fi

# ── Stage 5 ───────────────────────────────────────────────────────────────
stage "Switch dev from stub data to the real API"
say "In dev, Compass reads canned data from data/tito/*.edn instead of calling"
say "the API (:tito/fake-api-stubs? is true in resources/compass/dev.edn)."
if confirm "Use the real ti.to API locally?"; then
  write_edn ":tito/fake-api-stubs?" "false" raw
  note "The sync loop imports releases, registrations and tickets into the DB"
  note "every 15 minutes (:tito/sync-interval-seconds 900), starting at app boot."
else
  SKIPPED+=(":tito/fake-api-stubs? still true — dev keeps using data/tito/*.edn stubs")
  note "Keeping stubs — fine for pure UI work; ticket linking will only know"
  note "the fake registrations in data/tito/registrations.edn."
fi

# ── Stage 6 ───────────────────────────────────────────────────────────────
stage "Map ticket slugs → Discord roles (optional)"
say "When an attendee connects their ticket, Compass assigns the Discord role"
say "mapped to their ticket's release slug in :discord/ticket-roles."
if confirm "Configure the slug → role map now?"; then
  if [[ -z "$(edn_get ':discord/bot-token' || true)" ]]; then
    warn "No :discord/bot-token in $CONFIG_FILE — run bin/discord-wizard first,"
    warn "role assignment needs the bot."
  fi
  step "In Discord: Server Settings → Roles — create a role per ticket tier"
  say "  (plus one for the \"regular-ticket\" catch-all if you use those slugs)."
  warn "Drag the bot's own role ABOVE every ticket role, or assignment will 403."
  step "Enable Developer Mode (User Settings → Advanced), then right-click a"
  say "  role → 'Copy Role ID' for each."
  say "Enter pairs as slug=roleid, comma-separated,"
  note "e.g. early-bird=1234567890,streaming=0987654321,regular-ticket=1122334455"
  ask TICKET_ROLE_PAIRS "Pairs (empty to skip):"
  if [[ -n "$TICKET_ROLE_PAIRS" ]]; then
    TICKET_ROLES_EDN="{"
    IFS=',' read -ra _pairs <<< "$TICKET_ROLE_PAIRS"
    for _pair in "${_pairs[@]}"; do
      _slug="${_pair%%=*}"; _role="${_pair#*=}"
      _slug="${_slug// /}"; _role="${_role// /}"
      [[ -n "$_slug" && -n "$_role" ]] && TICKET_ROLES_EDN+="\"$_slug\" \"$_role\" "
    done
    TICKET_ROLES_EDN+="}"
    write_edn ":discord/ticket-roles" "$TICKET_ROLES_EDN" raw
  else
    SKIPPED+=(":discord/ticket-roles left as-is")
  fi
else
  SKIPPED+=(":discord/ticket-roles in $CONFIG_FILE")
fi

# ── Stage 7 ───────────────────────────────────────────────────────────────
stage "Gate livestreams by ticket slug (optional)"
say "Each entry in :mux/streams carries :allowed-ticket-slugs — the set of"
say "ti.to release slugs whose holders may watch that stream."
_stream_ids=$(bb -e "$_BB_STREAM_IDS" "$CONFIG_FILE" 2>/dev/null || true)
if [[ -z "$_stream_ids" ]]; then
  note "No :mux/streams configured in $CONFIG_FILE — run bin/create-mux-stream"
  note "first, then re-run this wizard to set the allowed slugs."
  SKIPPED+=(":mux/streams :allowed-ticket-slugs (no streams configured yet)")
elif confirm "Set allowed ticket slugs per stream now?"; then
  while IFS= read -r _sid; do
    [[ -z "$_sid" ]] && continue
    ask _SLUGS "Slugs allowed to watch '$_sid' (comma-separated, empty to skip):"
    if [[ -n "$_SLUGS" ]]; then
      bb -e "$_BB_SET_STREAM_SLUGS" "$CONFIG_FILE" "$_sid" "$_SLUGS"
      WRITTEN_ENV+=(":mux/streams[$_sid]")
      printf '  %s✓ wrote%s allowed-ticket-slugs for %s → %s\n' "$GREEN" "$RESET" "$_sid" "$CONFIG_FILE"
    fi
  done <<< "$_stream_ids"
else
  SKIPPED+=(":mux/streams :allowed-ticket-slugs in $CONFIG_FILE")
fi

# ── Stage 8 ───────────────────────────────────────────────────────────────
stage "Test the ticket-connect flow end to end"
say "Config files are watched under launchpad, so a running dev process picks"
say "up the changes; otherwise restart the app (bin/dev). The ti.to sync loop"
say "runs at boot and then every 15 minutes."
step "In ti.to, place a test order and ASSIGN the ticket to your own email."
say "  Note the 4-character registration reference (e.g. A1B2) from the order."
step "Sign in to Compass via Discord, then connect the ticket:"
if confirm "Is the app running at http://localhost:8099?"; then
  open_url "http://localhost:8099/ticket/connect"
fi
step "Enter the reference + the email the ticket was assigned to."
say "On success you're redirected home and the mapped Discord roles appear."
note "'Registration not found'        → sync hasn't run yet, or stubs still on (stage 5)."
note "'no ticket assigned to email'   → assign the ticket in ti.to and wait a sync."
note "Roles not assigned              → role map/slug mismatch, or bot role too low (stage 6)."
# ──────────────────────────────────────────────────────────────────────────

finish
