#!/usr/bin/env bash
#
# A wizard — walks a human through a manual procedure step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library — delightful, consistent UX. Identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear — wipe the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" — opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later — it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" — clear the screen, then announce a stage and show progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." — a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." — a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL — open in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else warn "couldn't open a browser — visit it manually: $url"; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser — visit it manually: $url"
}

# pause "msg" — wait for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" — y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY — current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# ask KEY "Prompt" — read a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" — like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE — upsert KEY=VALUE into ENV_FILE (creates it; replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE — set a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name — gh not ready; set it later"
}

# set_var NAME VALUE — set a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name — gh not ready; set it later"
}

# finish — clear, then a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES — author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# ──────────────────────────────────────────────────────────────────────────

TOTAL_STAGES=7

# Values land in config.local.edn (EDN), not .env. These helpers mirror the
# library's ask/write pair but read and upsert EDN keys via babashka, so the
# file stays valid EDN whatever the value contains. Keep-current defaults come
# from config.local.edn; the placeholder "..." counts as unset.
CONFIG_FILE="config.local.edn"
ENV_FILE="$CONFIG_FILE"  # so finish() reports the right file

_BB_GET='(let [[f k] *command-line-args*
               v (get (clojure.edn/read-string (slurp f)) (clojure.edn/read-string k))]
           (when (string? v) (print v)))'
_BB_SET='(let [[f k v raw] *command-line-args*
               m (clojure.edn/read-string (slurp f))
               v (if (seq raw) (clojure.edn/read-string v) v)]
           (spit f (with-out-str (clojure.pprint/pprint (into (sorted-map) (assoc m (clojure.edn/read-string k) v))))))'

require_bb() {
  command -v bb >/dev/null 2>&1 && return 0
  warn "babashka (bb) is required to edit $CONFIG_FILE — install it first: brew install borkdude/brew/babashka"
  exit 1
}

# edn_get :ns/key — current string value in CONFIG_FILE ("" if absent/placeholder)
edn_get() {
  [[ -f "$CONFIG_FILE" ]] || return 1
  local v
  v=$(bb -e "$_BB_GET" "$CONFIG_FILE" "$1") || return 1
  [[ "$v" == "..." ]] && v=""
  printf '%s' "$v"
}

# write_edn :ns/key VALUE [raw] — upsert into CONFIG_FILE. With the third arg
# set, VALUE is parsed as EDN (for maps); otherwise stored as a string.
write_edn() {
  local key="$1" value="$2" raw="${3:-}"
  [[ -f "$CONFIG_FILE" ]] || printf '{}\n' > "$CONFIG_FILE"
  bb -e "$_BB_SET" "$CONFIG_FILE" "$key" "$value" "$raw"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$CONFIG_FILE"
}

# ask_edn VAR "Prompt" :ns/key — like ask, but keep-current comes from EDN.
ask_edn() {
  local var="$1" prompt="$2" ekey="$3" current input
  current=$(edn_get "$ekey" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$var" '%s' "$input"
}

# ask_edn_secret VAR "Prompt" :ns/key — hidden-input variant of ask_edn.
ask_edn_secret() {
  local var="$1" prompt="$2" ekey="$3" current input
  current=$(edn_get "$ekey" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$var" '%s' "$input"
}

require_bb

banner "Compass — Discord application setup"

if [[ -f "$CONFIG_FILE" ]]; then
  cp "$CONFIG_FILE" "$CONFIG_FILE.wizard-bak"
  note "backed up $CONFIG_FILE → $CONFIG_FILE.wizard-bak"
fi

# ── Stage 1 ───────────────────────────────────────────────────────────────
stage "Developer portal — create the application"
say "Compass signs users in via Discord OAuth, so it needs a Discord application."
open_url "https://discord.com/developers/applications"
step "Click 'New Application', name it e.g. 'Compass (dev)', and create it."
step "On General Information, copy the Application ID."
ask_edn DISCORD_CLIENT_ID "Paste the Application ID:" ":discord/client-id"
step "On the same page, copy the Public Key."
ask_edn DISCORD_PUBLIC_KEY "Paste the Public Key:" ":discord/public-key"
write_edn ":discord/client-id" "$DISCORD_CLIENT_ID"
write_edn ":discord/public-key" "$DISCORD_PUBLIC_KEY"

# ── Stage 2 ───────────────────────────────────────────────────────────────
stage "OAuth2 — redirect URL and client secret"
say "Compass builds the callback as :compass/origin + /oauth2/discord/callback,"
say "so the redirect must match character for character."
open_url "https://discord.com/developers/applications/$DISCORD_CLIENT_ID/oauth2"
step "Under Redirects, click 'Add Redirect' and paste:"
say "    http://localhost:8099/oauth2/discord/callback"
note "For production add: https://compass.heartofclojure.eu/oauth2/discord/callback"
step "Save changes."
step "Under Client Secret, click 'Reset Secret' and copy it (shown only once)."
warn "Resetting invalidates any previously issued secret for this app."
ask_edn_secret DISCORD_CLIENT_SECRET "Paste the Client Secret:" ":discord/client-secret"
write_edn ":discord/client-secret" "$DISCORD_CLIENT_SECRET"
note "Scopes (identify, email, guilds.join) are requested at runtime — nothing to configure here."

# ── Stage 3 ───────────────────────────────────────────────────────────────
stage "Bot — token and intents"
say "The login flow also uses a bot token: it PUTs the user into your server"
say "(guilds.join), assigns ticket roles, and manages private session threads."
open_url "https://discord.com/developers/applications/$DISCORD_CLIENT_ID/bot"
step "Click 'Reset Token' and copy the bot token (shown only once)."
ask_edn_secret DISCORD_BOT_TOKEN "Paste the Bot Token:" ":discord/bot-token"
write_edn ":discord/bot-token" "$DISCORD_BOT_TOKEN"
step "Leave all Privileged Gateway Intents OFF — Compass only makes REST calls."
step "Optional: switch 'Public Bot' off so only you can invite it."
pause

# ── Stage 4 ───────────────────────────────────────────────────────────────
stage "Invite the bot to your server"
say "The bot must be a member of the server, with permissions matching the code:"
say "  Create Invite            → guilds.join (auto-add users after sign-in)"
say "  Manage Roles             → ticket role assignment"
say "  Create Private Threads   → per-session threads"
say "  Send Messages (+ in Threads) → posting into session threads"
say "  Manage Threads           → adding/removing thread members"
open_url "https://discord.com/oauth2/authorize?client_id=$DISCORD_CLIENT_ID&scope=bot&permissions=361045690369"
step "Pick your server and Authorize (you need Manage Server permission there)."
pause "Press Enter once the bot has joined the server."

# ── Stage 5 ───────────────────────────────────────────────────────────────
stage "Server & channel IDs"
say "IDs are copied from the Discord client itself."
step "In Discord: User Settings → Advanced → enable Developer Mode."
step "Right-click your server's icon → 'Copy Server ID'."
ask_edn DISCORD_SERVER_ID "Paste the Server ID:" ":discord/server-id"
step "Right-click the text channel where session threads should be created → 'Copy Channel ID'."
ask_edn DISCORD_SESSION_CHANNEL_ID "Paste the Channel ID:" ":discord/session-channel-id"
write_edn ":discord/server-id" "$DISCORD_SERVER_ID"
write_edn ":discord/session-channel-id" "$DISCORD_SESSION_CHANNEL_ID"

# ── Stage 6 ───────────────────────────────────────────────────────────────
stage "Ticket roles (optional)"
say "Compass maps ti.to release slugs to Discord roles, plus one catch-all"
say "'ticket holder' role. Skip this if you're only after sign-in for now."
if confirm "Set up ticket roles now?"; then
  step "In Discord: Server Settings → Roles — create the roles you need."
  warn "Drag the bot's own role ABOVE every ticket role, or role assignment will 403."
  step "Right-click a role → 'Copy Role ID' for each one."
  ask_edn DISCORD_TICKET_HOLDER_ROLE "Paste the catch-all ticket-holder Role ID:" ":discord/ticket-holder-role"
  write_edn ":discord/ticket-holder-role" "$DISCORD_TICKET_HOLDER_ROLE"
  say "Now the slug → role map. Enter pairs as slug=roleid, comma-separated,"
  note "e.g. early-bird=1234567890,regular-conference=0987654321"
  ask DISCORD_TICKET_ROLE_PAIRS "Pairs (empty to skip):"
  if [[ -n "$DISCORD_TICKET_ROLE_PAIRS" ]]; then
    TICKET_ROLES_EDN="{"
    IFS=',' read -ra _pairs <<< "$DISCORD_TICKET_ROLE_PAIRS"
    for _pair in "${_pairs[@]}"; do
      _slug="${_pair%%=*}"; _role="${_pair#*=}"
      _slug="${_slug// /}"; _role="${_role// /}"
      [[ -n "$_slug" && -n "$_role" ]] && TICKET_ROLES_EDN+="\"$_slug\" \"$_role\" "
    done
    TICKET_ROLES_EDN+="}"
    write_edn ":discord/ticket-roles" "$TICKET_ROLES_EDN" raw
  fi
else
  SKIPPED+=(":discord/ticket-roles and :discord/ticket-holder-role in $CONFIG_FILE")
fi

# ── Stage 7 ───────────────────────────────────────────────────────────────
stage "Test the sign-in flow"
say "Config files are watched under launchpad, so a running dev process picks"
say "up the changes; otherwise restart the app (bin/dev)."
step "Log in — the consent screen should list exactly: username/avatar, email,"
say "  and 'join servers for you'. Approving should land you back on Compass"
say "  with a welcome flash and add you to the server."
if confirm "Is the app running at http://localhost:8099?"; then
  open_url "http://localhost:8099"
fi
note "Exchange failed → redirect URL mismatch or stale secret (stage 2)."
note "Signed in but not added to server → bot token or Create Invite missing (stages 3-4)."
# ──────────────────────────────────────────────────────────────────────────

finish
