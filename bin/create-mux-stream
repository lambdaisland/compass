#!/usr/bin/env bb

(require
 '[babashka.http-client :as http]
 '[cheshire.core :as json]
 '[clojure.edn :as edn]
 '[clojure.java.io :as io]
 '[clojure.pprint :as pprint]
 '[clojure.string :as str])

(import
 '(java.nio.charset StandardCharsets)
 '(java.nio.file CopyOption Files StandardCopyOption)
 '(java.util Base64))

(def mux-live-streams-url "https://api.mux.com/video/v1/live-streams")
(def mux-rtmps-url "rtmps://global-live.mux.com:443/app")
(def config-file (io/file "config.local.edn"))

(defn fail! [message]
  (binding [*out* *err*]
    (println (str "Error: " message)))
  (System/exit 1))

(defn read-config []
  (when-not (.isFile config-file)
    (fail! "config.local.edn does not exist."))
  (let [value (edn/read-string (slurp config-file))]
    (when-not (map? value)
      (fail! "config.local.edn must contain one EDN map."))
    value))

(defn env-or-config [config env-name config-key]
  (or (not-empty (System/getenv env-name))
      (not-empty (get config config-key))))

(defn basic-authorization [token-id token-secret]
  (str "Basic "
       (.encodeToString
        (Base64/getEncoder)
        (.getBytes (str token-id ":" token-secret)
                   StandardCharsets/UTF_8))))

(defn create-live-stream! [token-id token-secret title test?]
  (let [response
        (http/post
         mux-live-streams-url
         {:headers {"Authorization" (basic-authorization token-id token-secret)
                    "Content-Type" "application/json"
                    "Accept" "application/json"}
          :body (json/generate-string
                 (cond->
                  {:playback_policies ["signed"]
                   :new_asset_settings {:playback_policies ["signed"]}
                   :meta {:title title}}
                   test? (assoc :test true)))
          :throw false})
        body (try
               (json/parse-string (:body response) true)
               (catch Exception _ nil))]
    (when-not (= 201 (:status response))
      (let [message (or (get-in body [:error :messages 0])
                        (get-in body [:error :message]))]
        (fail!
         (if (= "Live streams are unavailable on the free plan" message)
           (str message
                ". Mux requires a paid plan for both regular and test live streams; "
                "upgrade the account to Pay As You Go or higher.")
           (str "Mux returned HTTP " (:status response)
                (when message (str ": " message)))))))
    (:data body)))

(defn signed-playback-id [live-stream]
  (some (fn [{:keys [id policy]}]
          (when (= "signed" policy) id))
        (:playback_ids live-stream)))

(defn upsert-stream [streams stream]
  (->> (or streams [])
       (remove #(= (:id stream) (:id %)))
       vec
       (#(conj % stream))))

(defn write-config! [config stream]
  (let [backup-file (io/file "config.local.edn.bak")
        updated (update config :mux/streams upsert-stream stream)]
    (Files/copy (.toPath config-file)
                (.toPath backup-file)
                (into-array CopyOption [StandardCopyOption/REPLACE_EXISTING]))
    (binding [*print-namespace-maps* false]
      (spit config-file (with-out-str (pprint/pprint updated))))
    backup-file))

(let [test? (= "--test" (first *command-line-args*))
      args (if test? (rest *command-line-args*) *command-line-args*)
      [stream-id title & ticket-slugs] args
      stream-id (or stream-id "main-stage")
      title (or title "Main Stage")
      ticket-slugs (set (if (seq ticket-slugs) ticket-slugs ["streaming"]))
      config (read-config)
      token-id (env-or-config config "MUX_TOKEN_ID" :mux/token-id)
      token-secret (env-or-config config "MUX_TOKEN_SECRET" :mux/token-secret)]
  (when-not (re-matches #"[a-z0-9]+(?:-[a-z0-9]+)*" stream-id)
    (fail! "stream ID must be a lowercase URL-safe slug, for example main-stage."))
  (when (str/blank? title)
    (fail! "stream title must not be blank."))
  (when-not token-id
    (fail! "set MUX_TOKEN_ID or :mux/token-id in config.local.edn."))
  (when-not token-secret
    (fail! "set MUX_TOKEN_SECRET or :mux/token-secret in config.local.edn."))
  (let [live-stream (create-live-stream! token-id token-secret title test?)
        playback-id (signed-playback-id live-stream)
        stream-key (:stream_key live-stream)]
    (when-not playback-id
      (fail! "Mux created the stream but did not return a signed playback ID."))
    (when-not stream-key
      (fail! "Mux created the stream but did not return a stream key."))
    (let [stream {:id stream-id
                  :title title
                  :playback-id playback-id
                  :allowed-ticket-slugs ticket-slugs}
          backup-file (write-config! config stream)]
      (println (str "Mux " (when test? "test ")
                    "live stream created and :mux/streams updated."))
      (println "Live stream ID:" (:id live-stream))
      (println "Playback ID:" playback-id)
      (println "OBS server:" mux-rtmps-url)
      (println "OBS stream key:" stream-key)
      (println "Combined OBS URL:" (str mux-rtmps-url "/" stream-key))
      (println "Config backup:" (.getPath backup-file)))))
